<!DOCTYPE html>
<html>
<head>
  <title>Users List</title>

  <style>
    body {
      font-family: Arial;
      padding: 20px;
    }

    .user-card {
      border: 1px solid #ccc;
      padding: 10px;
      margin-bottom: 10px;
      border-radius: 5px;
    }
  </style>
</head>

<body>

<h1>Sample Users</h1>

<% users.forEach(user => { %>

  <div class="user-card">
    <h3><%= user.name %></h3>

    <p>ID: <%= user.id %></p>

    <p>Role: <%= user.role %></p>

    <a href="/users/<%= user.id %>">
      View Profile
    </a>
  </div>

<% }) %>

</body>
</html>